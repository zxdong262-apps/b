//- 投票统计页面专用样式（scoped 前缀 cv-）+ 饼图 mixin
style.
  .cv-cards { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .cv-card { background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius-lg);
             padding: 14px 16px; box-shadow: var(--shadow-sm); }
  .cv-label { color: var(--c-text-2); font-size: 0.78rem; }
  .cv-val { font-size: 1.6rem; font-weight: 700; margin-top: 4px; }
  .cv-card.ok .cv-val { color: var(--c-success); }
  .cv-card.no .cv-val { color: var(--c-danger); }
  .cv-card.big .cv-val { color: var(--c-primary); }
  .cv-donut-block { display: flex; flex-direction: column; align-items: center; gap: 10px; margin: 14px 0 4px; }
  .cv-legend { font-size: 0.85rem; color: var(--c-text-2); line-height: 1.9; }
  .cv-legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 6px; vertical-align: middle; }
  .cv-legend b { color: var(--c-text); }
  .cv-mini { width: 48px; text-align: center; }
  .cv-ok { color: var(--c-success); font-weight: 600; }
  .cv-no { color: var(--c-danger); }
  .cv-tag { display: inline-block; font-size: 0.7rem; color: var(--c-muted); background: var(--c-muted-bg);
            border-radius: 6px; padding: 1px 7px; margin-left: 6px; }
  .cv-btn { width: 100%; margin: 14px 0; }
  body.only-unvoted tr.cv-r-v { display: none; }
  @media (min-width: 560px) {
    .cv-cards { grid-template-columns: repeat(2, 1fr); }
    .cv-btn { width: auto; }
  }
  @media (min-width: 900px) {
    .cv-cards { grid-template-columns: repeat(4, 1fr); }
    .cv-donut-block { flex-direction: row; justify-content: center; gap: 26px; }
  }

//- 饼图（环形）mixin: voted 已投数, total 总数, size 直径, stroke 环宽, label 圆心文字
mixin donut(voted, total, size, stroke, label)
  - const r = (size - stroke) / 2, cx = size / 2, cy = size / 2, circ = 2 * Math.PI * r, f = total ? voted / total : 0, vl = f * circ
  svg(viewBox="0 0 " + size + " " + size width=size height=size style="max-width:100%;height:auto" aria-label="已投" + voted + "/共" + total)
    circle(cx=cx cy=cy r=r fill="none" stroke="#e3e8ef" stroke-width=stroke)
    circle(cx=cx cy=cy r=r fill="none" stroke="var(--c-success)" stroke-width=stroke
           stroke-dasharray=vl.toFixed(2) + " " + circ.toFixed(2) stroke-dashoffset="0"
           transform="rotate(-90 " + cx + " " + cy + ")" stroke-linecap="round")
    if label
      text(x=cx y=(cy + size * 0.07) text-anchor="middle" font-size=(size * 0.22) font-weight="700" fill="var(--c-primary)")= label
